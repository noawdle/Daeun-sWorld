<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- FOD: 렌치 + 볼트 형태의 작은 금속 부품 (약 0.3 m). 모델 원점 = 바닥 중심 -->
  <model name="vp_fod">
    <static>true</static>
    <link name="body">
      <collision name="col">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry><box><size>0.32 0.12 0.04</size></box></geometry>
      </collision>
      <visual name="wrench_handle">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry><box><size>0.26 0.035 0.02</size></box></geometry>
        <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
      </visual>
      <visual name="wrench_head">
        <pose>0.14 0 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.022</length></cylinder></geometry>
        <material><ambient>0.6 0.62 0.65 1</ambient><diffuse>0.6 0.62 0.65 1</diffuse><specular>0.9 0.9 0.9 1</specular></material>
      </visual>
      <visual name="bolt">
        <pose>-0.05 0.07 0.012 0 1.5708 0.4</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.09</length></cylinder></geometry>
        <material><ambient>0.75 0.6 0.2 1</ambient><diffuse>0.75 0.6 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
