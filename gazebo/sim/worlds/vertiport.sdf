<?xml version="1.0" encoding="UTF-8"?>
<!--
  스마트 버티포트 시뮬레이션 world
  - 팀 공통 좌표계: World ENU, 원점 = 착륙패드 중심 (x=East, y=North, z=Up)
  - 착륙패드(vp_pad)는 반드시 원점에 둔다. 다른 객체를 옮길 것.
  - 기체 스폰 위치(이륙 대기 위치)는 vp_stand (-6, 0). run_sim.sh 의 SPAWN_X/SPAWN_Y 와 일치시킬 것.
  - 시스템 플러그인을 world 에 직접 선언하면 Gazebo 가 server.config 를 읽지 않으므로
    PX4 server.config 의 표준 플러그인을 모두 나열한다.
    특히 UserCommands 가 있어야 /world/vertiport/create, /remove, /set_pose 서비스가 생긴다.
-->
<sdf version="1.9">
  <world name="vertiport">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <!-- 지자기장 (ENU, Tesla): GPS 기준점(대구)의 값과 맞춤 - 편각 -8.9°, 복각 53.3°, 50.9 µT (WMM 근사).
         PX4 EKF 는 위경도로 편각을 조회하므로, 이 값이 기준점과 다르면 yaw 가 그 차이만큼 틀어진다.
         (PX4 기본 world 값 6e-06 2.3e-05 -4.2e-05 는 편각 +14.6° → 대구 기준점과 약 23° 차이) -->
    <magnetic_field>-4.706e-06 3.005e-05 -4.081e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.62 0.75 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.3 0.5 -0.8</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>2000</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>

    <!-- 지면 (잔디색) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
          <surface><friction><ode/></friction><bounce/><contact/></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material>
            <ambient>0.33 0.42 0.28 1</ambient>
            <diffuse>0.33 0.42 0.28 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 버티포트 에이프런 (아스팔트) 30 m x 24 m, visual only -->
    <model name="apron">
      <static>true</static>
      <pose>-3 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="asphalt">
          <geometry><plane><normal>0 0 1</normal><size>30 24</size></plane></geometry>
          <material>
            <ambient>0.22 0.23 0.25 1</ambient>
            <diffuse>0.22 0.23 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <!-- 스탠드 → 패드 유도선 (노랑) -->
        <visual name="taxi_line">
          <pose>0 0 0.0005 0 0 0</pose>
          <geometry><box><size>3.0 0.12 0.001</size></box></geometry>
          <material><ambient>0.95 0.75 0.1 1</ambient><diffuse>0.95 0.75 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 착륙패드: 팀 좌표 원점 -->
    <include>
      <uri>model://vp_pad</uri>
      <name>pad_1</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- 이륙 대기 위치 (기체 스폰 지점) -->
    <include>
      <uri>model://vp_stand</uri>
      <name>stand_1</name>
      <pose>-6 0 0 0 0 0</pose>
    </include>

    <!-- 터미널 건물 (배경용) -->
    <model name="terminal">
      <static>true</static>
      <pose>-10 14 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>16 6 5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>16 6 5</size></box></geometry>
          <material><ambient>0.75 0.77 0.8 1</ambient><diffuse>0.75 0.77 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- GPS 기준점: 경북대학교 부근 (PX4 home). 좌표계와는 무관, NavSat 용 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>35.8889</latitude_deg>
      <longitude_deg>128.6103</longitude_deg>
      <elevation>50</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
