# ==========================================================================
#  팀 고정 버전 (Single source of truth)
#  - install.sh / check_env.sh / verify_versions.sh 가 이 파일을 읽는다.
#  - 바꿀 때는 팀 전체 합의 후 README 의 "확정 조합" 표도 같이 수정할 것.
# ==========================================================================

# ✅ 2026-11-25 확정: Gazebo 담당 PC = Ubuntu 22.04 → ROS 2 Humble
#   (PX4 공식 권장 조합 · Jetson JetPack 6 과 동일 OS → 실기체 연동 시 유리)
#   PC 가 24.04 로 바뀌면 UBUNTU_VERSION=24.04, ROS_DISTRO=jazzy
UBUNTU_VERSION=22.04
ROS_DISTRO=humble

GZ_RELEASE=harmonic              # PX4 v1.16+ 공식 지원 Gazebo (LTS)
PX4_TAG=v1.17.0                  # PX4-Autopilot 릴리스 태그
PX4_MSGS_BRANCH=release/1.17     # px4_msgs 브랜치 - 반드시 PX4_TAG 와 같은 마이너 버전
XRCE_AGENT_TAG=v2.4.3            # Micro-XRCE-DDS-Agent (PX4 클라이언트는 v2.x 와만 호환, v3.x 금지)

PX4_SIM_MODEL=gz_x500_mono_cam_down   # 하향 카메라 X500 (airframe 4014)
PX4_GZ_WORLD=vertiport

# 설치 경로 (필요하면 환경변수로 덮어쓰기)
PX4_DIR=${PX4_DIR:-$HOME/PX4-Autopilot}
XRCE_DIR=${XRCE_DIR:-$HOME/Micro-XRCE-DDS-Agent}
